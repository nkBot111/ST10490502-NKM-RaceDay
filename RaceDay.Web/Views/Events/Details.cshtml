@model RaceDay.Web.ViewModels.EventDetailsViewModel

@{
    ViewData["Title"] = Model.EventName;
}

<div class="container py-5">

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        ← Back to Events
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="rounded-4 text-white p-4 p-md-5 mb-4"
         style="background: linear-gradient(135deg, #102b3f, #137c70);">

        <span class="badge bg-warning text-dark mb-3">
            @Model.EventType
        </span>

        <h1 class="display-5 fw-bold">
            @Model.EventName
        </h1>

        <p class="lead mb-0">
            @Model.Location
        </p>
    </div>

    <div class="row g-4">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-4">
                        Event Information
                    </h3>

                    <p>
                        <strong>Date:</strong>
                        @Model.EventDate.ToString("dd MMMM yyyy")
                    </p>

                    <p>
                        <strong>Start Time:</strong>
                        @Model.StartTime.ToString(@"hh\:mm")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @Model.Location
                    </p>

                    <p>
                        <strong>Distance:</strong>
                        @Model.DistanceKm km
                    </p>

                    <p>
                        <strong>Event Type:</strong>
                        @Model.EventType
                    </p>

                    <p>
                        <strong>Organiser:</strong>
                        @Model.OrganiserName
                    </p>

                    <p>
                        <strong>Maximum Participants:</strong>
                        @Model.MaximumParticipants
                    </p>

                    <p>
                        <strong>Status:</strong>

                        @if (Model.Status == "Open")
                        {
                            <span class="badge bg-success">
                                Open
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }
                    </p>

                    <hr />

                    <h5 class="fw-bold">About This Event</h5>

                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "No additional description available."
                                                : Model.Description)
                    </p>

                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Available Categories
                    </h3>

                    @if (Model.Categories.Count == 0)
                    {
                        <p class="text-muted">
                            No categories have been added yet.
                        </p>
                    }
                    else
                    {
                        @foreach (var category in Model.Categories)
                        {
                            <div class="border rounded-3 p-3 mb-3">

                                <h5 class="fw-bold">
                                    @category.CategoryName
                                </h5>

                                <span class="badge bg-info text-dark">
                                    @category.CategoryType
                                </span>

                                @if (category.DistanceKm.HasValue)
                                {
                                    <p class="mt-2 mb-1">
                                        Distance: @category.DistanceKm km
                                    </p>
                                }

                                @if (category.MinimumAge.HasValue ||
                                                        category.MaximumAge.HasValue)
                                {
                                    <p class="mb-1">
                                        Age:
                                        @(category.MinimumAge?.ToString() ?? "Any")
                                        -
                                        @(category.MaximumAge?.ToString() ?? "Any")
                                    </p>
                                }

                                <p class="text-muted mb-0">
                                    @category.Description
                                </p>

                            </div>
                        }
                    }

                </div>
            </div>

        </div>

        <div class="col-lg-5">

            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Enter This Race
                    </h3>

                    <p class="text-muted">
                        Select your preferred category to enrol.
                    </p>

                    @if (Model.Status == "Open" &&
                                        Model.EventDate.Date >= DateTime.Today &&
                                        Model.Categories.Count > 0)
                    {
                        <form asp-controller="Events"
                              asp-action="Enroll"
                              asp-route-id="@Model.EventID"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="mb-4">

                                <label for="categoryId"
                                       class="form-label fw-semibold">
                                    Choose Category
                                </label>

                                <select id="categoryId"
                                        name="categoryId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Select a Category --
                                    </option>

                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryID">
                                            @category.CategoryName
                                        </option>
                                    }

                                </select>

                            </div>

                            <button type="submit"
                                    class="btn btn-success btn-lg w-100">
                                Enrol Now
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Enrolment is not currently available
                            for this event.
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
