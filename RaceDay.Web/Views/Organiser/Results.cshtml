@model RaceDay.Web.ViewModels.EventResultsPageViewModel
@{ ViewData["Title"] = "Race Results"; }
<div class="container py-5"><a asp-action="Index" class="btn btn-outline-secondary mb-3">← My Events</a><h1 class="fw-bold">Race Results</h1><p class="text-muted">@Model.EventName</p>
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
<h3 class="mt-4">Record results</h3>
@{ var pending = Model.Enrollments.Where(e => e.EnrollmentStatus == "Active").ToList(); }
@if (pending.Count == 0) { <div class="alert alert-info">No active entries awaiting a result. Check the Enrolments page and enrol as a Participant first.</div> }
@foreach (var e in pending) {
  <div class="card border-0 shadow-sm rounded-4 mb-3"><div class="card-body p-3 p-md-4">
    <h5 class="fw-bold">@e.ParticipantName <small class="text-muted">(@e.CategoryName)</small></h5>
    <form asp-action="RecordResult" method="post" class="row g-2 align-items-end">
      @Html.AntiForgeryToken()
      <input type="hidden" name="EventID" value="@Model.EventID" /><input type="hidden" name="EnrollmentID" value="@e.EnrollmentID" />
      <div class="col-md-4"><label class="form-label">Finish time (hh:mm:ss)</label><input name="FinishTime" class="form-control" value="00:32:15" required /></div>
      <div class="col-md-2"><label class="form-label">Overall place</label><input type="number" name="OverallPosition" class="form-control" min="1" value="1" required /></div>
      <div class="col-md-2"><label class="form-label">Category place</label><input type="number" name="CategoryPosition" class="form-control" min="1" value="1" required /></div>
      <div class="col-md-4"><button type="submit" class="btn btn-success w-100">Save Result</button></div>
    </form>
  </div></div>
}
<h3 class="mt-5">Published results</h3>
@if (Model.Results.Count == 0) { <div class="alert alert-light border">No results published yet.</div> }
else { <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Place</th><th>Participant</th><th>Category</th><th>Finish Time</th></tr></thead><tbody>@foreach (var r in Model.Results) { <tr><td>@r.OverallPosition</td><td>@r.ParticipantName</td><td>@r.CategoryName</td><td>@(r.FinishTime.ToString(@"hh\:mm\:ss"))</td></tr> }</tbody></table></div> }
</div>
