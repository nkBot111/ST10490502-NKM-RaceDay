@model RaceDay.Web.ViewModels.CategoryFormViewModel
@{ ViewData["Title"] = "Add Category"; }
<div class="container py-5"><div class="card border-0 rounded-4 shadow-sm"><div class="card-body p-4 p-md-5"><h1 class="fw-bold">Add Race Category</h1>
<form asp-action="AddCategory" method="post">
  @Html.AntiForgeryToken()<input asp-for="EventID" type="hidden" />
  <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
  <div class="row g-3">
    <div class="col-md-8"><label asp-for="CategoryName" class="form-label">Category Name</label><input asp-for="CategoryName" class="form-control" placeholder="5KM Fun Run" /></div>
    <div class="col-md-4"><label asp-for="CategoryType" class="form-label">Category Type</label><select asp-for="CategoryType" class="form-select"><option value="Distance">Distance</option><option value="Age">Age</option></select></div>
    <div class="col-md-4"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" /><small class="text-muted">Required for Distance categories</small></div>
    <div class="col-md-4"><label asp-for="MinimumAge" class="form-label">Min age</label><input asp-for="MinimumAge" type="number" min="0" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="MaximumAge" class="form-label">Max age</label><input asp-for="MaximumAge" type="number" min="0" class="form-control" /></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" rows="2" class="form-control"></textarea></div>
  </div>
  <div class="d-flex gap-2 mt-4"><button class="btn btn-success" type="submit">Save Category</button><a asp-action="Categories" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div></div>
