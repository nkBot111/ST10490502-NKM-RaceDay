@model List<RaceDay.Web.ViewModels.OrganiserEnrollmentViewModel>
@{ ViewData["Title"] = "Event Enrolments"; }
<div class="container py-5"><a asp-action="Index" class="btn btn-outline-secondary mb-3">← My Events</a><h1 class="fw-bold">Event Enrolments</h1><p class="text-muted">@ViewBag.EventName</p>
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (Model.Count == 0) { <div class="alert alert-info">Nobody has enrolled in this event yet. Have a Participant select an event category and join the race.</div> }
else { <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Entry Date</th><th>Status</th></tr></thead><tbody>
@foreach (var e in Model) { <tr><td>@e.ParticipantName <small class="d-block text-muted">@e.ParticipantEmail</small></td><td>@e.CategoryName</td><td>@e.EnrollmentDate.ToString("dd MMM yyyy")</td><td>@e.EnrollmentStatus</td></tr> }
</tbody></table></div> }
<a asp-action="Results" asp-route-eventId="@ViewBag.EventID" class="btn btn-success">Record Results</a></div>
