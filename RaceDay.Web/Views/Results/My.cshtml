@model List<RaceDay.Web.ViewModels.RaceResultViewModel>
@{ ViewData["Title"] = "My Results"; }
<div class="container py-5"><h1 class="fw-bold">My Race Results</h1><p class="text-muted">Your recorded race finishes.</p>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
@if (Model.Count == 0) { <div class="alert alert-info">You have no race results yet.</div> }
else { <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Event</th><th>Category</th><th>Time</th><th>Overall Place</th><th>Category Place</th></tr></thead><tbody>@foreach (var r in Model) { <tr><td>@r.EventName</td><td>@r.CategoryName</td><td>@(r.FinishTime.ToString(@"hh\:mm\:ss"))</td><td>@r.OverallPosition</td><td>@r.CategoryPosition</td></tr> }</tbody></table></div> }
</div>
