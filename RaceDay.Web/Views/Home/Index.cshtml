@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "RaceDay Dashboard";

    string? role = Context.Session.GetString("Role");
    string firstName = Context.Session.GetString("FirstName") ?? "User";
}

<div class="container py-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (role == "Organiser")
    {
        <div class="p-4 p-md-5 rounded-4 text-white mb-5"
             style="background: linear-gradient(135deg, #102b3f, #137c70);">

            <span class="badge bg-warning text-dark mb-3">
                ORGANISER DASHBOARD
            </span>

            <h1 class="display-5 fw-bold">
                Welcome back, @firstName!
            </h1>

            <p class="lead mb-0">
                Manage your RaceDay events, categories,
                participants and race results from one place.
            </p>
        </div>

        <h2 class="fw-bold mb-4">Organiser Management</h2>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="fs-2 mb-3">🏃</div>

                        <h5 class="fw-bold">My Events</h5>

                        <p class="text-muted">
                            Create, update and manage your sporting events.
                        </p>

                        <a asp-controller="Organiser" asp-action="Index" class="btn btn-success">Manage Events</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="fs-2 mb-3">📋</div>

                        <h5 class="fw-bold">Categories</h5>

                        <p class="text-muted">
                            Manage age and distance categories
                            for your events.
                        </p>

                        <a asp-controller="Organiser" asp-action="Index" class="btn btn-success">Manage Categories</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="fs-2 mb-3">👥</div>

                        <h5 class="fw-bold">Enrolments</h5>

                        <p class="text-muted">
                            View participants registered for your events.
                        </p>

                        <a asp-controller="Organiser" asp-action="Index" class="btn btn-success">View Enrolments</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="fs-2 mb-3">🏆</div>

                        <h5 class="fw-bold">Race Results</h5>

                        <p class="text-muted">
                            Capture and manage participant finish times.
                        </p>

                        <a asp-controller="Organiser" asp-action="Index" class="btn btn-success">Record Results</a>
                    </div>
                </div>
            </div>

        </div>
    }
    else if (role == "Participant")
    {
        <div class="p-4 p-md-5 rounded-4 text-white mb-5"
             style="background: linear-gradient(135deg, #102b3f, #137c70);">

            <span class="badge bg-warning text-dark mb-3">
                PARTICIPANT DASHBOARD
            </span>

            <h1 class="display-5 fw-bold">
                Welcome to RaceDay, @firstName!
            </h1>

            <p class="lead mb-4">
                Discover sporting events, enrol in races
                and follow your racing journey.
            </p>

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-warning btn-lg fw-bold">
                Explore Upcoming Events
            </a>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">
                Your RaceDay Journey
            </h2>
        </div>

        <div class="row g-4">

            <!-- EXPLORE EVENTS -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4 d-flex flex-column">

                        <div class="fs-2 mb-3">🏃</div>

                        <h4 class="fw-bold">
                            Explore Events
                        </h4>

                        <p class="text-muted">
                            Find upcoming running, walking and cycling
                            events that match your interests.
                        </p>

                        <div class="mt-auto">
                            <a asp-controller="Events"
                               asp-action="Index"
                               class="btn btn-success w-100">
                                Browse Events
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <!-- MY ENROLMENTS -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4 d-flex flex-column">

                        <div class="fs-2 mb-3">📋</div>

                        <h4 class="fw-bold">
                            My Enrolments
                        </h4>

                        <p class="text-muted">
                            Track the races you have entered,
                            your selected categories and enrolment status.
                        </p>

                        <div class="mt-auto">
                            <a asp-controller="Enrollments" asp-action="Index" class="btn btn-success w-100">My Enrolments</a>
                        </div>

                    </div>
                </div>
            </div>

            <!-- MY RESULTS -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4 d-flex flex-column">

                        <div class="fs-2 mb-3">🏆</div>

                        <h4 class="fw-bold">
                            My Results
                        </h4>

                        <p class="text-muted">
                            View your race history, finishing positions
                            and recorded finish times.
                        </p>

                        <div class="mt-auto">
                            <a asp-controller="Results" asp-action="My" class="btn btn-success w-100">My Results</a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <span class="badge bg-warning text-dark mb-3">
                WELCOME TO RACEDAY
            </span>

            <h1 class="display-4 fw-bold">
                Your Race. Your Journey.
            </h1>

            <p class="lead text-muted mb-4">
                Discover running, walking and cycling events
                across South Africa.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-success btn-lg me-2">
                Sign In
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-outline-success btn-lg">
                Create Account
            </a>

        </div>
    }

</div>
