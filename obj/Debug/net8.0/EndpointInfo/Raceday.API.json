          "eventType",
          "location",
          "maximumParticipants",
          "startTime",
          "status"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "startTime": {
            "type": "string",
            "format": "date-span"
          },
          "location": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 1000,
            "minimum": 0.1,
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "maximumParticipants": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProfileRequest": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "emergencyContactName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "emergencyContactNumber": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ResultRequest": {
        "required": [
          "categoryPosition",
          "finishTime",
          "overallPosition"
        ],
        "type": "object",
        "properties": {
          "finishTime": {
            "type": "string",
            "format": "date-span"
          },
          "overallPosition": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "categoryPosition": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
