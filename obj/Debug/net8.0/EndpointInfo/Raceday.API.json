  "components": {
    "schemas": {
      "CategoryRequest": {
        "required": [
          "categoryName",
          "categoryType"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "categoryType": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "minimumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maximumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "distanceKm": {
