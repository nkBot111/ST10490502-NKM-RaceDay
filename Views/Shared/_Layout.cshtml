@using Microsoft.AspNetCore.Http

@{
    string? role = Context.Session.GetString("Role");
    string firstName = Context.Session.GetString("FirstName") ?? "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        body {
            background-color: #f4f7f9;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #142b3b;
        }

        .raceday-navbar {
            background: linear-gradient(120deg, #102b3f, #116b64);
            padding: 15px 0;
        }

        .raceday-logo {
            color: #ffffff !important;
            font-weight: 800;
            font-size: 26px;
            letter-spacing: -1px;
            text-decoration: none;
        }

            .raceday-logo span {
                color: #ffc107;
            }

        .raceday-link {
            color: #ffffff !important;
            font-weight: 500;
            margin-right: 12px;
        }

            .raceday-link:hover {
                color: #ffc107 !important;
            }

        .raceday-role {
            background-color: #ffc107;
            color: #142b3b;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .raceday-main {
            min-height: 75vh;
        }

        .raceday-footer {
            background: #102b3f;
            color: #d9e4eb;
            padding: 25px 0;
            margin-top: 60px;
        }

            .raceday-footer p {
                margin: 0;
                font-size: 14px;
            }

        .card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card:hover {
                transform: translateY(-3px);
            }
    </style>
</head>

<body>

    <!-- MAIN NAVIGATION -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">

            <div class="container">

                <!-- RACEDAY LOGO -->
                <a class="navbar-brand raceday-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    RACE<span>DAY</span>
                </a>

                <!-- MOBILE NAVIGATION BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <!-- LEFT NAVIGATION -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link raceday-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link raceday-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Organiser Dashboard
                                </a>
                            </li>
                        }
                        else if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link raceday-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    My Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link raceday-link"
                                   asp-controller="Events"
                                   asp-action="Index">
                                    Explore Events
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- RIGHT NAVIGATION -->
                    <div class="d-flex align-items-center gap-3 flex-wrap">

                        @if (role == "Organiser" ||
                                                role == "Participant")
                        {
                            <span class="raceday-role">
                                @role
                            </span>

                            <span class="text-white">
                                Hi, @firstName
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">
                                    Log Out
                                </button>

                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-outline-light">
                                Sign In
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-warning fw-bold">
                                Join RaceDay
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main role="main" class="raceday-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="raceday-footer">
        <div class="container text-center">
            <p>
                &copy; 2026 RaceDay.
                Run. Walk. Cycle. Achieve.
            </p>
        </div>
    </footer>

    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
